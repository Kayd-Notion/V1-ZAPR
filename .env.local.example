# ---------------------------------------------------------------------------
# ZAPR — environment configuration
# Copy to .env.local and adjust (git-ignored). On Vercel: Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Solana network -------------------------------------------------------
# SECURITY: keep this on "devnet" until the on-chain program is audited.
# Switching to "mainnet-beta" makes pumps move REAL SOL.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional custom RPC endpoint (Helius/QuickNode...). Falls back to the public
# cluster RPC for the selected cluster when empty.
NEXT_PUBLIC_SOLANA_RPC=

# --- Site address -----------------------------------------------------------
# Public URL of the site (e.g. https://zapr.xyz), used for absolute links in
# social previews. Empty: the Vercel production URL.
NEXT_PUBLIC_SITE_URL=

# --- Pump split -----------------------------------------------------------
# Basis points (10000 = 100%). Must sum to 10000. Configurable, not hard-coded.
NEXT_PUBLIC_PUMP_CREATOR_BPS=7000
NEXT_PUBLIC_PUMP_FOUNDER_BPS=3000
# Founder (Kayd) wallet that receives the platform share of every pump.
# On devnet this can be any devnet address you control for testing.
NEXT_PUBLIC_FOUNDER_WALLET=

# --- Auth / session -------------------------------------------------------
# Secret used to sign the session JWT stored in an httpOnly cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=dev-only-insecure-secret-change-me

# When "true", the server re-checks each pump's on-chain transaction (payer,
# recipients, split, success) before recording it. Strongly recommended in
# production. Leave "false" only for local dev without a real browser wallet.
PUMP_REQUIRE_ONCHAIN_VERIFY=true

# --- Database -------------------------------------------------------------
# Leave empty to use the built-in file-backed dev store (seeded mock data).
# Set to a Supabase/Neon Postgres connection string to use real Postgres.
# e.g. postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Media upload (Irys / Arweave) ---------------------------------------
# Irys network: "devnet" pairs with Solana devnet (free-ish, ephemeral),
# "mainnet" is permanent Arweave storage paid in SOL.
NEXT_PUBLIC_IRYS_NETWORK=devnet
